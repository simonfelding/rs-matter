# syntax=docker/dockerfile:1
FROM rust:alpine AS builder
RUN apk add --no-cache build-base binutils
WORKDIR /build
COPY . .
ARG BINARY=onoff_light_switch
RUN cargo build --release --package rs-matter-examples --bin "$BINARY" \
    && cp "target/release/$BINARY" /rs-matter \
    && ! readelf -l /rs-matter | grep -q INTERP \
    && mkdir /data

FROM scratch
COPY --from=builder /rs-matter /rs-matter
COPY --from=builder /data /data
ENV TMPDIR=/data RUST_LOG=info
VOLUME ["/data"]
ENTRYPOINT ["/rs-matter"]
